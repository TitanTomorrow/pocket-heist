rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Development rule: any signed-in user can read and write any document.
    // Signed-out visitors get nothing. Expires at the start of 1 Jan 2027 (UTC);
    // replace it with per-user rules (below) before then.
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.time < timestamp.date(2027, 1, 1);
    }

    // Per-user rule, disabled for now. Each user can only access their own
    // heists, stored at personalData/pocket-heist/users/{uid}/heists/{heistId}.
    // To switch over, uncomment this block and delete the development rule above.
    //match /personalData/{appId}/users/{uid}/{collectionName}/{docId} {
    //  allow get: if request.auth != null && request.auth.uid == uid;
    //  allow list: if request.auth != null && request.auth.uid == uid
    //    && request.query.limit <= 100;
    //  allow write: if request.auth != null && request.auth.uid == uid;
    //}
  }
}
